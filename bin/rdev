#!/usr/bin/env bash

# rdev — persistent remote shells in the current terminal.
# All state is isolated under ~/.config/rdev and never modifies ~/.ssh/config.

set -o pipefail

RDEV_VERSION="0.4.0"
APP_NAME="${RDEV_APP_NAME:-rdev · 远程开发}"
CONFIG_DIR="${RDEV_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/rdev}"
NODES_FILE="$CONFIG_DIR/nodes.conf"
SETTINGS_FILE="$CONFIG_DIR/config"
SSH_CONFIG="$CONFIG_DIR/ssh_config"
STATE_FILE="$CONFIG_DIR/last-node"
LAST_CONNECTION_FILE="$CONFIG_DIR/last-connection"
WORKSPACES_FILE="$CONFIG_DIR/workspaces.conf"
CONTROL_DIR="$CONFIG_DIR/control"

SSH_BIN="${RDEV_SSH_BIN:-$(command -v ssh 2>/dev/null || printf ssh)}"

NODE_IDS=()
NODE_LABELS=()
NODE_HOSTS=()
NODE_USERS=()
NODE_PORTS=()
NODE_IDENTITIES=()
NODE_PROXY_JUMPS=()
NODE_SSH_ARGS=()
WORKSPACE_NAMES=()

AUTO_INSTALL_REMOTE="yes"
CONNECT_TIMEOUT="10"
RECONNECT_DELAY="2"

# This script intentionally expands only on the remote host.
# shellcheck disable=SC2016
REMOTE_PREPARE='set -e
export PATH="$HOME/.local/bin:$HOME/.bun/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

rdev_run_root() {
  if [ "$(id -u)" -eq 0 ]; then
    "$@"
  elif command -v sudo >/dev/null 2>&1; then
    sudo "$@"
  else
    echo "dtach is missing and sudo is unavailable." >&2
    return 126
  fi
}

if ! command -v dtach >/dev/null 2>&1; then
  if [ "$rdev_auto_install" != "yes" ]; then
    echo "Remote dtach is not installed." >&2
    exit 127
  fi
  echo "First connection: installing dtach on the remote node…" >&2
  if command -v apt-get >/dev/null 2>&1; then
    rdev_run_root env DEBIAN_FRONTEND=noninteractive apt-get update -qq >&2
    rdev_run_root env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq dtach >&2
  elif command -v dnf >/dev/null 2>&1; then
    rdev_run_root dnf install -y dtach >&2
  elif command -v pacman >/dev/null 2>&1; then
    rdev_run_root pacman -Sy --noconfirm dtach >&2
  elif command -v zypper >/dev/null 2>&1; then
    rdev_run_root zypper --non-interactive install dtach >&2
  elif command -v apk >/dev/null 2>&1; then
    rdev_run_root apk add dtach >&2
  elif command -v brew >/dev/null 2>&1; then
    brew install dtach >&2
  else
    echo "No supported dtach package source was found on the remote node." >&2
    exit 127
  fi
fi

hash -r 2>/dev/null || true
command -v dtach >/dev/null 2>&1 ||
  { echo "Remote dtach installation did not provide an executable." >&2; exit 127; }'

REMOTE_ATTACH='set -e
umask 077
rdev_session_dir="${XDG_RUNTIME_DIR:-$HOME/.cache}/rdev/sessions"
mkdir -p "$rdev_session_dir"
chmod 700 "$rdev_session_dir" 2>/dev/null || true
rdev_socket="$rdev_session_dir/$rdev_session.sock"
rdev_shell="${SHELL:-/bin/sh}"
exec dtach -A "$rdev_socket" -r winch "$rdev_shell" -l'

cleanup_screen() {
  printf '\033[0m\033[?25h'
}

install_ui_traps() {
  trap cleanup_screen EXIT
  trap 'printf "\n"; exit 130' INT
  trap 'printf "\n"; exit 129' HUP
  trap 'printf "\n"; exit 143' TERM
}

write_default_settings() {
  [ -e "$SETTINGS_FILE" ] && return 0
  umask 077
  {
    printf '%s\n' \
      '# rdev settings' \
      'auto_install_remote=yes' \
      'connect_timeout=10' \
      'reconnect_delay=2'
  } > "$SETTINGS_FILE"
}

write_default_ssh_config() {
  [ -e "$SSH_CONFIG" ] && return 0
  umask 077
  {
    printf '%s\n' \
      '# rdev-only SSH options used while preparing remote nodes.' \
      '# Add Host blocks here when a node needs custom SSH options.' \
      'Include ~/.ssh/config'
  } > "$SSH_CONFIG"
}

init_config() {
  umask 077
  mkdir -p "$CONFIG_DIR" "$CONTROL_DIR"
  chmod 700 "$CONFIG_DIR" "$CONTROL_DIR" 2>/dev/null || true
  [ -e "$NODES_FILE" ] || printf '%s\n' '# id|label|host|user|ssh_port|identity_file|proxy_jump' > "$NODES_FILE"
  [ -e "$WORKSPACES_FILE" ] || printf '%s\n' '# node_id|workspace' > "$WORKSPACES_FILE"
  chmod 600 "$NODES_FILE" "$WORKSPACES_FILE" 2>/dev/null || true
  write_default_settings
  write_default_ssh_config
}

load_settings() {
  local key value
  while IFS='=' read -r key value; do
    case "$key" in
      ''|\#*) continue ;;
      auto_install_remote) [ "$value" = yes ] || [ "$value" = no ] || continue; AUTO_INSTALL_REMOTE="$value" ;;
      connect_timeout) case "$value" in *[!0-9]*|'') continue ;; esac; CONNECT_TIMEOUT="$value" ;;
      reconnect_delay) case "$value" in *[!0-9]*|'') continue ;; esac; RECONNECT_DELAY="$value" ;;
    esac
  done < "$SETTINGS_FILE"
}

slugify() {
  local slug
  slug="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9._-]/-/g; s/--*/-/g; s/^-//; s/-$//')"
  [ -n "$slug" ] || slug="node-$(date +%s)"
  REPLY="$slug"
}

validate_field() {
  case "$2" in
    *'|'*|*'
'*) printf '%s cannot contain "|" or a newline.\n' "$1" >&2; return 1 ;;
  esac
}

migrate_nodes_config() {
  local fields backup temp line id label host user port transport socket identity proxy_jump mosh_port extra
  fields="$(awk -F'|' '!/^[[:space:]]*(#|$)/ { print NF; exit }' "$NODES_FILE")"
  case "$fields" in ''|7) return 0 ;; 4|10) ;; *) return 0 ;; esac

  backup="$NODES_FILE.pre-dtach.$(date +%Y%m%d%H%M%S)"
  temp="$NODES_FILE.tmp.$$"
  cp "$NODES_FILE" "$backup" || return 1
  printf '%s\n' '# id|label|host|user|ssh_port|identity_file|proxy_jump' > "$temp"

  if [ "$fields" = 10 ]; then
    while IFS='|' read -r id label host user port transport socket identity proxy_jump mosh_port extra; do
      case "$id" in ''|\#*) continue ;; esac
      [ -z "$extra" ] || continue
      printf '%s|%s|%s|%s|%s|%s|%s\n' "$id" "$label" "$host" "$user" "$port" "$identity" "$proxy_jump" >> "$temp"
    done < "$NODES_FILE"
  else
    while IFS='|' read -r label host socket transport extra; do
      case "$label" in ''|\#*) continue ;; esac
      [ -z "$extra" ] || continue
      slugify "${host#rdev-}"
      id="$REPLY"
      line="$("$SSH_BIN" -G -F "$SSH_CONFIG" "$host" 2>/dev/null || true)"
      user="$(printf '%s\n' "$line" | awk '$1=="user"{print $2;exit}')"
      port="$(printf '%s\n' "$line" | awk '$1=="port"{print $2;exit}')"
      [ -n "$user" ] || user="${USER:-$(id -un)}"
      [ -n "$port" ] || port=22
      printf '%s|%s|%s|%s|%s||\n' "$id" "$label" "$host" "$user" "$port" >> "$temp"
    done < "$NODES_FILE"
  fi

  mv "$temp" "$NODES_FILE"
  chmod 600 "$NODES_FILE"
  printf 'Migrated node configuration for SSH + dtach. Backup: %s\n' "$backup" >&2
}

load_nodes() {
  local id label host user port identity proxy_jump extra
  NODE_IDS=()
  NODE_LABELS=()
  NODE_HOSTS=()
  NODE_USERS=()
  NODE_PORTS=()
  NODE_IDENTITIES=()
  NODE_PROXY_JUMPS=()

  while IFS='|' read -r id label host user port identity proxy_jump extra; do
    case "$id" in ''|\#*) continue ;; esac
    if [ -n "$extra" ] || [ -z "$label" ] || [ -z "$host" ] || [ -z "$user" ] || [ -z "$port" ]; then
      printf 'Invalid node configuration for "%s" in %s\n' "$id" "$NODES_FILE" >&2
      return 1
    fi
    NODE_IDS[${#NODE_IDS[@]}]="$id"
    NODE_LABELS[${#NODE_LABELS[@]}]="$label"
    NODE_HOSTS[${#NODE_HOSTS[@]}]="$host"
    NODE_USERS[${#NODE_USERS[@]}]="$user"
    NODE_PORTS[${#NODE_PORTS[@]}]="$port"
    NODE_IDENTITIES[${#NODE_IDENTITIES[@]}]="$identity"
    NODE_PROXY_JUMPS[${#NODE_PROXY_JUMPS[@]}]="$proxy_jump"
  done < "$NODES_FILE"
}

find_node_index() {
  local reference="$1" i
  case "$reference" in
    *[!0-9]*|'') ;;
    *)
      if [ "$reference" -ge 1 ] 2>/dev/null && [ "$reference" -le "${#NODE_IDS[@]}" ]; then
        REPLY="$((reference - 1))"
        return 0
      fi
      ;;
  esac
  i=0
  while [ "$i" -lt "${#NODE_IDS[@]}" ]; do
    if [ "${NODE_IDS[$i]}" = "$reference" ]; then REPLY="$i"; return 0; fi
    i=$((i + 1))
  done
  return 1
}

build_ssh_args() {
  local index="$1"
  NODE_SSH_ARGS=(
    -F "$SSH_CONFIG"
    -p "${NODE_PORTS[$index]}"
    -l "${NODE_USERS[$index]}"
    -o "ConnectTimeout=$CONNECT_TIMEOUT"
    -o ControlMaster=auto
    -o "ControlPath=$CONTROL_DIR/%C"
    -o ControlPersist=60
  )
  [ -n "${NODE_IDENTITIES[$index]}" ] && NODE_SSH_ARGS+=( -i "${NODE_IDENTITIES[$index]}" )
  [ -n "${NODE_PROXY_JUMPS[$index]}" ] && NODE_SSH_ARGS+=( -J "${NODE_PROXY_JUMPS[$index]}" )
}

header() {
  command -v clear >/dev/null 2>&1 && clear 2>/dev/null || printf '\033[2J\033[H'
  printf '\033[1;36m%s\033[0m\n' "$APP_NAME"
  printf '%s\n\n' '────────────────────────────────────────'
}

choose_number() {
  local prompt="$1" max="$2" default_value="${3:-}" answer
  while true; do
    if [ -n "$default_value" ]; then
      printf '%s [Enter=%s, q=quit]: ' "$prompt" "$default_value"
    else
      printf '%s [q=quit]: ' "$prompt"
    fi
    IFS= read -r answer || return 1
    case "$answer" in q|Q) return 1 ;; esac
    [ -z "$answer" ] && [ -n "$default_value" ] && answer="$default_value"
    case "$answer" in
      *[!0-9]*|'') ;;
      *) if [ "$answer" -ge 1 ] 2>/dev/null && [ "$answer" -le "$max" ]; then REPLY="$answer"; return 0; fi ;;
    esac
    printf '\033[31mChoose a number from 1 to %d.\033[0m\n' "$max"
  done
}

pick_node() {
  local i default_node="" last_id
  if [ "${#NODE_IDS[@]}" -eq 0 ]; then
    printf 'No nodes yet. Add one with:\n  rdev add NAME HOST --user USER [--port 22]\n'
    return 2
  fi

  header
  printf '\033[1m选择远程节点 · Select a node\033[0m\n\n'
  i=0
  while [ "$i" -lt "${#NODE_LABELS[@]}" ]; do
    printf '  \033[36m%d\033[0m) %s\n' "$((i + 1))" "${NODE_LABELS[$i]}"
    i=$((i + 1))
  done

  if [ -r "$STATE_FILE" ]; then
    IFS= read -r last_id < "$STATE_FILE" || true
    i=0
    while [ "$i" -lt "${#NODE_IDS[@]}" ]; do
      if [ "${NODE_IDS[$i]}" = "$last_id" ]; then default_node="$((i + 1))"; break; fi
      i=$((i + 1))
    done
  fi

  printf '\n'
  choose_number "Node" "${#NODE_LABELS[@]}" "$default_node" || return 1
  NODE_INDEX="$((REPLY - 1))"
  printf '%s\n' "${NODE_IDS[$NODE_INDEX]}" > "$STATE_FILE"
}

load_workspaces() {
  local node_id="$1" saved_node workspace extra
  WORKSPACE_NAMES=()
  while IFS='|' read -r saved_node workspace extra; do
    case "$saved_node" in ''|\#*) continue ;; esac
    [ -z "$extra" ] || continue
    [ "$saved_node" = "$node_id" ] || continue
    [ -n "$workspace" ] && WORKSPACE_NAMES[${#WORKSPACE_NAMES[@]}]="$workspace"
  done < "$WORKSPACES_FILE"
}

record_workspace() {
  local node_id="$1" workspace="$2" saved_node saved_workspace extra
  while IFS='|' read -r saved_node saved_workspace extra; do
    [ -z "$extra" ] || continue
    [ "$saved_node" = "$node_id" ] && [ "$saved_workspace" = "$workspace" ] && return 0
  done < "$WORKSPACES_FILE"
  printf '%s|%s\n' "$node_id" "$workspace" >> "$WORKSPACES_FILE"
}

pick_workspace() {
  local index="$1" node_id="${NODE_IDS[$index]}" i generated workspace selected
  load_workspaces "$node_id"
  header
  printf '\033[1m%s · 当前终端\033[0m\n\n' "${NODE_LABELS[$index]}"
  printf '  \033[32m1\033[0m) ＋ New workspace\n'
  i=0
  while [ "$i" -lt "${#WORKSPACE_NAMES[@]}" ]; do
    printf '  \033[36m%d\033[0m) %s\n' "$((i + 2))" "${WORKSPACE_NAMES[$i]}"
    i=$((i + 1))
  done
  printf '\n'
  choose_number "Workspace" "$(( ${#WORKSPACE_NAMES[@]} + 1 ))" || return 1
  selected="$REPLY"
  if [ "$selected" -eq 1 ]; then
    generated="work-$(date +%m%d-%H%M)"
    printf 'Workspace name [Enter=%s]: ' "$generated"
    IFS= read -r workspace || return 1
    [ -n "$workspace" ] || workspace="$generated"
    case "$workspace" in *[!A-Za-z0-9_.-]*|'') printf '\nWorkspace names may only contain letters, numbers, ".", "_" and "-".\n'; return 2 ;; esac
  else
    workspace="${WORKSPACE_NAMES[$((selected - 2))]}"
  fi
  WORKSPACE_NAME="$workspace"
  record_workspace "$node_id" "$workspace"
}

prepare_remote() {
  local index="$1"
  build_ssh_args "$index"
  printf '%s\n' "$REMOTE_PREPARE" |
    "$SSH_BIN" -T "${NODE_SSH_ARGS[@]}" "${NODE_HOSTS[$index]}" \
      "rdev_auto_install=$AUTO_INSTALL_REMOTE exec sh -s"
}

shell_quote() {
  local value="$1"
  value="$(printf '%s' "$value" | sed "s/'/'\\\\''/g")"
  printf "'%s'" "$value"
}

session_key() {
  REPLY="s$(printf '%s' "$1|$2" | cksum | awk '{print $1}')"
}

connect_node() {
  local index="$1" workspace="$2" session remote_command connect_rc
  header
  printf '\033[1m%s\033[0m\n' "${NODE_LABELS[$index]}"
  printf 'Workspace: \033[36m%s\033[0m\n\n' "$workspace"
  printf '正在准备远程会话… · Preparing remote session…\n'
  prepare_remote "$index" || return $?
  session_key "${NODE_IDS[$index]}" "$workspace"
  session="$REPLY"
  remote_command="rdev_session=$session exec sh -c $(shell_quote "$REMOTE_ATTACH")"
  printf '%s|%s\n' "${NODE_IDS[$index]}" "$workspace" > "$LAST_CONNECTION_FILE"

  while true; do
    printf '正在当前终端连接… · Connecting in the current terminal…\n'
    "$SSH_BIN" -tt "${NODE_SSH_ARGS[@]}" "${NODE_HOSTS[$index]}" "$remote_command"
    connect_rc=$?
    [ "$connect_rc" -eq 255 ] || return "$connect_rc"
    printf '\n连接中断，%s 秒后重连；按 Ctrl-C 停止。 · Disconnected; reconnecting in %ss. Ctrl-C stops.\n' \
      "$RECONNECT_DELAY" "$RECONNECT_DELAY" >&2
    sleep "$RECONNECT_DELAY"
  done
}

command_resume() {
  local node_id workspace extra index
  load_nodes || return 1
  if [ ! -r "$LAST_CONNECTION_FILE" ]; then
    printf 'No previous remote workspace is available.\n'
    return 0
  fi
  IFS='|' read -r node_id workspace extra < "$LAST_CONNECTION_FILE" || true
  if [ -n "$extra" ] || [ -z "$node_id" ] || [ -z "$workspace" ] || ! find_node_index "$node_id"; then
    printf 'No previous remote workspace is available.\n'
    return 0
  fi
  index="$REPLY"
  connect_node "$index" "$workspace"
}

run_menu() {
  local pick_rc
  install_ui_traps
  load_nodes || return 1
  while true; do
    pick_node
    pick_rc=$?
    [ "$pick_rc" -eq 2 ] && return 0
    [ "$pick_rc" -ne 0 ] && return 0
    pick_workspace "$NODE_INDEX"
    pick_rc=$?
    [ "$pick_rc" -eq 1 ] && continue
    [ "$pick_rc" -eq 2 ] && continue
    connect_node "$NODE_INDEX" "$WORKSPACE_NAME"
    return $?
  done
}

prompt_default() {
  local prompt="$1" default_value="$2" value
  printf '%s [%s]: ' "$prompt" "$default_value"
  IFS= read -r value || return 1
  [ -n "$value" ] || value="$default_value"
  REPLY="$value"
}

command_add() {
  local name="" host="" user="${USER:-$(id -un)}" port=22 identity="" proxy_jump="" requested_id="" id pair
  local -a positionals
  positionals=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --user|-u) [ "$#" -ge 2 ] || { printf '%s requires a value.\n' "$1" >&2; return 2; }; user="$2"; shift 2 ;;
      --port|-p) [ "$#" -ge 2 ] || { printf '%s requires a value.\n' "$1" >&2; return 2; }; port="$2"; shift 2 ;;
      --identity|-i) [ "$#" -ge 2 ] || { printf '%s requires a value.\n' "$1" >&2; return 2; }; identity="$2"; shift 2 ;;
      --proxy-jump|-J) [ "$#" -ge 2 ] || { printf '%s requires a value.\n' "$1" >&2; return 2; }; proxy_jump="$2"; shift 2 ;;
      --id) [ "$#" -ge 2 ] || { printf '%s requires a value.\n' "$1" >&2; return 2; }; requested_id="$2"; shift 2 ;;
      --help|-h) usage_add; return 0 ;;
      --*) printf 'Unknown add option: %s\n' "$1" >&2; return 2 ;;
      *) positionals[${#positionals[@]}]="$1"; shift ;;
    esac
  done

  [ "${#positionals[@]}" -ge 1 ] && name="${positionals[0]}"
  [ "${#positionals[@]}" -ge 2 ] && host="${positionals[1]}"
  [ "${#positionals[@]}" -le 2 ] || { printf 'add accepts at most NAME and HOST as positional arguments.\n' >&2; return 2; }
  if [ -z "$name" ]; then printf 'Display name: '; IFS= read -r name || return 1; fi
  if [ -z "$host" ]; then printf 'Host or IP: '; IFS= read -r host || return 1; fi
  [ -n "$name" ] && [ -n "$host" ] || { printf 'NAME and HOST are required.\n' >&2; return 2; }

  if [ "${#positionals[@]}" -eq 0 ]; then
    prompt_default "SSH user" "$user" || return 1; user="$REPLY"
    prompt_default "SSH port" "$port" || return 1; port="$REPLY"
  fi
  case "$port" in *[!0-9]*|'') printf 'SSH port must be a number.\n' >&2; return 2 ;; esac
  [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || { printf 'SSH port must be between 1 and 65535.\n' >&2; return 2; }
  for pair in "name:$name" "host:$host" "user:$user" "identity:$identity" "proxy-jump:$proxy_jump"; do
    validate_field "${pair%%:*}" "${pair#*:}" || return 2
  done
  if [ -n "$requested_id" ]; then REPLY="$requested_id"; else slugify "$name"; fi
  id="$REPLY"
  case "$id" in *[!a-zA-Z0-9._-]*|'') printf 'Node ID contains unsupported characters: %s\n' "$id" >&2; return 2 ;; esac

  load_nodes || return 1
  if find_node_index "$id"; then
    printf 'A node with ID "%s" already exists. Remove it first or choose --id.\n' "$id" >&2
    return 2
  fi
  printf '%s|%s|%s|%s|%s|%s|%s\n' "$id" "$name" "$host" "$user" "$port" "$identity" "$proxy_jump" >> "$NODES_FILE"
  chmod 600 "$NODES_FILE"
  printf 'Added %s (%s@%s:%s via SSH + dtach).\n' "$name" "$user" "$host" "$port"
}

command_list() {
  local i
  load_nodes || return 1
  if [ "${#NODE_IDS[@]}" -eq 0 ]; then printf 'No nodes configured.\n'; return 0; fi
  printf '%-4s %-20s %-28s %s\n' '#' 'ID' 'LABEL' 'TARGET'
  i=0
  while [ "$i" -lt "${#NODE_IDS[@]}" ]; do
    printf '%-4s %-20s %-28s %s@%s:%s\n' "$((i + 1))" "${NODE_IDS[$i]}" "${NODE_LABELS[$i]}" "${NODE_USERS[$i]}" "${NODE_HOSTS[$i]}" "${NODE_PORTS[$i]}"
    i=$((i + 1))
  done
}

command_remove() {
  local reference="${1:-}" remove_index remove_id temp line line_id
  [ -n "$reference" ] || { printf 'Usage: rdev remove ID|NUMBER\n' >&2; return 2; }
  load_nodes || return 1
  find_node_index "$reference" || { printf 'Node not found: %s\n' "$reference" >&2; return 1; }
  remove_index="$REPLY"
  remove_id="${NODE_IDS[$remove_index]}"
  temp="$NODES_FILE.tmp.$$"
  : > "$temp"
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|\#*) printf '%s\n' "$line" >> "$temp"; continue ;; esac
    line_id="${line%%|*}"
    [ "$line_id" = "$remove_id" ] || printf '%s\n' "$line" >> "$temp"
  done < "$NODES_FILE"
  mv "$temp" "$NODES_FILE"
  chmod 600 "$NODES_FILE"
  temp="$WORKSPACES_FILE.tmp.$$"
  : > "$temp"
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in "$remove_id|"*) continue ;; *) printf '%s\n' "$line" >> "$temp" ;; esac
  done < "$WORKSPACES_FILE"
  mv "$temp" "$WORKSPACES_FILE"
  chmod 600 "$WORKSPACES_FILE"
  printf 'Removed node: %s\n' "$remove_id"
}

command_doctor() {
  local failures=0 dependency
  printf 'rdev %s\n' "$RDEV_VERSION"
  printf 'Config: %s\n' "$CONFIG_DIR"
  for dependency in ssh awk sed cksum; do
    if command -v "$dependency" >/dev/null 2>&1; then
      printf '  [ok] %s: %s\n' "$dependency" "$(command -v "$dependency")"
    else
      printf '  [!!] %s: not installed locally\n' "$dependency"
      failures=$((failures + 1))
    fi
  done
  printf '  [--] dtach: checked and installed on each remote node when needed\n'
  load_nodes || failures=$((failures + 1))
  printf 'Nodes:  %d\n' "${#NODE_IDS[@]}"
  [ "$failures" -eq 0 ]
}

usage_add() {
  cat <<'EOF'
Usage:
  rdev add NAME HOST [options]
  rdev add                         Interactive mode

Options:
  -u, --user USER                 SSH user (default: current user)
  -p, --port PORT                 SSH port (default: 22)
  -i, --identity FILE             SSH private key
  -J, --proxy-jump HOST           SSH jump host
      --id ID                     Stable configuration ID

Example:
  rdev add "Build server" 10.0.0.8 --user root --port 2224
EOF
}

usage() {
  cat <<EOF
rdev $RDEV_VERSION — persistent remote shells in your current terminal

Usage:
  rdev                         Open the node and workspace menu
  rdev resume                  Reopen the last remote workspace
  rdev menu                    Open the node and workspace menu
  rdev add [NAME HOST] [...]   Add a node (interactive when omitted)
  rdev list                    List configured nodes
  rdev remove ID|NUMBER        Remove a node
  rdev edit                    Edit the independent node file
  rdev config                  Show configuration paths
  rdev doctor                  Check the installation
  rdev version                 Show the version
  rdev help                    Show this help

Remote dtach is installed on first connection when missing; no local terminal is launched.
Run "rdev add --help" for all node options.
EOF
}

main() {
  local command_name
  init_config || return 1
  load_settings
  migrate_nodes_config || return 1
  command_name="${1:-}"
  [ "$#" -gt 0 ] && shift
  case "$command_name" in
    '') run_menu ;;
    resume) command_resume ;;
    menu) run_menu ;;
    add) command_add "$@" ;;
    list|ls) command_list ;;
    remove|rm|delete) command_remove "$@" ;;
    edit) "${EDITOR:-vi}" "$NODES_FILE" ;;
    config)
      printf 'config=%s\nnodes=%s\nssh_config=%s\nworkspaces=%s\n' "$SETTINGS_FILE" "$NODES_FILE" "$SSH_CONFIG" "$WORKSPACES_FILE"
      ;;
    doctor) command_doctor ;;
    version|--version|-V) printf 'rdev %s\n' "$RDEV_VERSION" ;;
    help|--help|-h) usage ;;
    *) printf 'Unknown command: %s\n\n' "$command_name" >&2; usage >&2; return 2 ;;
  esac
}

main "$@"
